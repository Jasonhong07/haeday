{
  "name": "haeday",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "sentry:test": "tsx scripts/sentry-test.ts",
    "places:build": "tsx scripts/build-cities.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "oracle:update": "python tools/oracle/gen_jie.py && python tools/oracle/build_golden.py",
    "oracle:lunar": "python tools/oracle/crosscheck_lunar.py",
    "oracle:verify": "python tools/oracle/verify.py && vitest run tests/engine"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@sentry/nextjs": "11.0.0",
    "drizzle-orm": "0.45.3",
    "luxon": "3.7.2",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
