# Template only; use environment variables. Do not put real credentials here.
APP_ENV=dev
APP_ORIGIN=http://localhost:3000
PAYMENTS_MODE=test
LIVE_PAYMENTS_APPROVED=false
# DATABASE_URL=
# SESSION_SECRET=at-least-32-random-characters
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SAJU=
# Only after Stripe Tax is set up in the dashboard (docs/QUESTIONS.md Q4)
STRIPE_AUTOMATIC_TAX=false
# LLM_API_KEY=
# LLM_MODEL=
# Max generation attempts per UTC day. 0 = paid readings stay closed (fail closed).
LLM_DAILY_CAP=0
# RESEND_API_KEY=
# EMAIL_FROM=
# SUPPORT_EMAIL=
ADMIN_EMAILS=
# POSTHOG_KEY=
# SENTRY_DSN=
FLAGS={}
# TZDATA_VERSION=
# D17 private-data keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# ENCRYPTION_KEYS={"k1":"<base64-32-bytes>"}
# ENCRYPTION_ACTIVE_KEY_ID=k1
# EMAIL_LOOKUP_KEY=<base64-32-bytes>
